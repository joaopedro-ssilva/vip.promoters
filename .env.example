# VIP Promoters - copie para .env e ajuste. Nunca versione o .env.
ENVIRONMENT=development            # development | production
APP_URL=http://localhost:3000      # URL publica do frontend (redirects, links de convite, URLs de upload)
ALLOWED_ORIGINS=http://localhost:3000

# Banco / Redis (hosts internos do Docker Compose)
POSTGRES_USER=vip
POSTGRES_PASSWORD=                 # openssl rand -hex 24 (volume ja criado com outra senha? use a antiga)
POSTGRES_DB=vip
# Papel de APLICACAO (criado por `migrate`): sem superusuario e sem BYPASSRLS, para o Row
# Level Security valer. O compose monta o DATABASE_URL a partir destes dois.
APP_DB_USER=vip_app
APP_DB_PASSWORD=                   # openssl rand -hex 24
REDIS_URL=redis://redis:6379/0

# Segredos (em producao: obrigatorio gerar valores novos)
SECRET_KEY=                        # openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=              # openssl rand -base64 32 | tr '+/' '-_'
META_WEBHOOK_VERIFY_TOKEN=         # openssl rand -hex 16

COOKIE_SECURE=false                # true em producao (HTTPS)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
TRUSTED_PROXY_HOPS=1               # proxies confiaveis a frente do backend (Next.js = 1)

# Meta / Instagram
META_MOCK_MODE=true                # true: tudo funciona sem app da Meta
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_WEBHOOK_SECRET=               # so se os webhooks vierem assinados com outra chave (ver docs/META.md)
SYNC_INTERVAL_SECONDS=120

# Rotacao de chaves: a anterior continua valendo so para leitura (ver README, Seguranca)
SECRET_KEY_PREVIOUS=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Retencao (dias): interacoes de campanhas encerradas ha mais tempo sao anonimizadas
RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90

SEED_DEMO=true                     # dados de demonstracao no primeiro boot (somente development)
LOG_LEVEL=INFO
BACKEND_INTERNAL_URL=http://backend:8000   # usado pelo frontend
